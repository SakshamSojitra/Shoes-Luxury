# Copy this file to `.env` in the project root and fill values for local development.
# DO NOT COMMIT real secrets to version control. Use this as a template only.

# Razorpay (test keys)
# - `RAZORPAY_KEY_ID` and `RAZORPAY_KEY_SECRET` are used by the backend (server).
# - `VITE_RAZORPAY_KEY_ID` is the public key exposed to the frontend (Vite) so the checkout can open.
# Get test keys from: https://dashboard.razorpay.com/app/keys (use Test mode)
RAZORPAY_KEY_ID=rzp_test_your_server_key_id_here
RAZORPAY_KEY_SECRET=your_server_key_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id_here

# MySQL (for order storage)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=example_password
MYSQL_DATABASE=shoes_db

# Optional: server port
PORT=5000

# Optional: legacy MongoDB (if you still use it)
# MONGO_URI=mongodb://user:pass@localhost:27017/dbname
